# Keitaro
KEITARO_URL=https://tlgk.host
# Admin -> Профиль -> API ключи
KEITARO_API_KEY=put-your-api-key-here

# Префикс имени кампании: test_<фамилия>_
CAMPAIGN_PREFIX=test_ivanov_

# Значения по умолчанию для новой кампании (можно поменять в UI)
DEFAULT_DOMAIN_ID=1813
DEFAULT_GROUP_ID=10332
DEFAULT_TRAFFIC_SOURCE_ID=836
GOOGLE_URL=https://google.com

# SQLite по умолчанию; для Postgres: postgresql+asyncpg://user:pass@localhost/keitaro (pip install asyncpg)
DATABASE_URL=sqlite+aiosqlite:///./keitaro_wrapper.db
